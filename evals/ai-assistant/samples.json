{
  "version": 1,
  "plan": "docs/plans/AI_ASSISTANT_PLAN.md",
  "samples": [
    { "id": "concept-01", "category": "concept", "page": "lab", "role": "learner", "mode": "concept",
      "question": "DECLARE 和 CONSTANT 有什么区别？什么时候该用常量？",
      "expect": "explain", "mustNot": [], "grading": "说清值能否改变、常量在程序开头定义；用占位名举例。" },
    { "id": "concept-02", "category": "concept", "page": "lab", "role": "student", "mode": "concept",
      "question": "为什么 9618 里赋值用 ← 而不是 =？",
      "expect": "explain", "mustNot": [], "grading": "= 在 9618 里是比较运算；赋值只能用 ←。" },
    { "id": "concept-03", "category": "concept", "page": "lab", "role": "student", "mode": "concept",
      "question": "DIV 和 MOD 分别算的是什么？",
      "expect": "explain", "mustNot": [], "grading": "整除商与余数，两边都要求 INTEGER。" },
    { "id": "concept-04", "category": "concept", "page": "lab", "role": "learner", "mode": "concept",
      "question": "BYVAL 和 BYREF 我总是分不清，能用生活里的例子说一下吗？",
      "expect": "explain", "mustNot": [], "grading": "副本与原件；不必写代码也能讲清楚。" },
    { "id": "concept-05", "category": "concept", "page": "lab", "role": "student", "mode": "concept",
      "question": "什么时候用 CASE OF，什么时候用一串 IF？",
      "expect": "explain", "mustNot": [], "grading": "一个值对多种情况用 CASE；条件涉及多个变量或复杂比较用 IF。" },
    { "id": "concept-06", "category": "concept", "page": "lab", "role": "student", "mode": "concept",
      "question": "数组下界一定要从 1 开始吗？",
      "expect": "explain", "mustNot": [], "grading": "下界由声明决定，9618 常见为 1；越界由声明的上下界判断。" },
    { "id": "concept-07", "category": "concept", "page": "lab", "role": "learner", "mode": "concept",
      "question": "过程和函数的区别是什么？考试里怎么判断该写哪个？",
      "expect": "explain", "mustNot": [], "grading": "函数返回值、用在表达式里；过程用 CALL。" },
    { "id": "concept-08", "category": "concept", "page": "lab", "role": "student", "mode": "concept",
      "question": "STRING 和 CHAR 能互相赋值吗？",
      "expect": "explain", "mustNot": [], "grading": "按项目规则包回答类型兼容性，不凭通用编程语言经验猜。" },
    { "id": "concept-09", "category": "concept", "page": "lab", "role": "student", "mode": "concept",
      "question": "FOR 循环的计数器需要先 DECLARE 吗？",
      "expect": "explain", "mustNot": [], "grading": "必须与项目规则包一致：FOR 的控制变量不必 DECLARE。答反了算失败——这一条专门检查是否以规则包为准。" },
    { "id": "concept-10", "category": "concept", "page": "lab", "role": "student", "mode": "concept",
      "question": "INT(3.7) 的结果是多少？为什么？",
      "expect": "explain", "mustNot": [], "grading": "截去小数部分得 3，不是四舍五入。" },
    { "id": "concept-11", "category": "concept", "page": "lab", "role": "learner", "mode": "concept",
      "question": "OPENFILE 的 READ、WRITE、APPEND 三种模式各会对原来的文件做什么？",
      "expect": "explain", "mustNot": [], "grading": "WRITE 覆盖、APPEND 接在末尾、READ 只读。" },
    { "id": "concept-12", "category": "concept", "page": "lab", "role": "student", "mode": "concept",
      "question": "伪代码里字符串连接用 + 还是 &？",
      "expect": "explain", "mustNot": [], "grading": "用 &。" },
    { "id": "concept-13", "category": "concept", "page": "lab", "role": "student", "mode": "concept",
      "question": "什么是栈？和队列有什么不一样？",
      "expect": "explain", "mustNot": [], "grading": "后进先出与先进先出；不需要给实现代码。" },
    { "id": "concept-14", "category": "concept", "page": "lab", "role": "student", "mode": "concept",
      "question": "TYPE ... ENDTYPE 定义的记录和数组有什么区别？",
      "expect": "explain", "mustNot": [], "grading": "记录是不同类型字段的组合，数组是同类型元素的序列。" },
    { "id": "concept-15", "category": "concept", "page": "learn", "role": "student", "mode": "concept",
      "context": { "sectionRef": "5.5" },
      "question": "前测循环和后测循环到底差在哪？",
      "expect": "explain", "mustNot": [], "grading": "条件在前还是在后、后测至少执行一次；结合当前小节。" },

    { "id": "diagnostic-01", "category": "diagnostic", "page": "lab", "role": "student", "mode": "diagnostic",
      "context": { "code": ["DECLARE Total : INTEGER", "Total = 0", "OUTPUT Total"], "diagnostics": ["PC2102"] },
      "question": "这行为什么报错？我明明就是想让 Total 等于 0。",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "解释赋值要用 ←；示例用占位名，不写出 Total ← 0。" },
    { "id": "diagnostic-02", "category": "diagnostic", "page": "lab", "role": "student", "mode": "diagnostic",
      "context": { "code": ["DECLARE Name : STRING", "Name ← 42", "OUTPUT Name"], "diagnostics": ["PC4000"] },
      "question": "Name 不能放数字吗？",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "类型不兼容；42 是 INTEGER 字面量，STRING 字面量要加引号。" },
    { "id": "diagnostic-03", "category": "diagnostic", "page": "lab", "role": "student", "mode": "diagnostic",
      "context": { "code": ["Score ← 10", "OUTPUT Score"], "diagnostics": ["PC3003"] },
      "question": "它说 Score 没有定义，可我第一行就给它赋值了。",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "赋值不等于声明；变量要先 DECLARE。" },
    { "id": "diagnostic-04", "category": "diagnostic", "page": "lab", "role": "student", "mode": "diagnostic",
      "context": { "code": ["DECLARE Score : INTEGER", "INPUT Score", "IF Score >= 50", "   OUTPUT \"Pass\"", "ENDIF"], "diagnostics": ["PC2101"] },
      "question": "IF 这里报错是什么意思？",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "IF 条件后缺 THEN。" },
    { "id": "diagnostic-05", "category": "diagnostic", "page": "lab", "role": "student", "mode": "diagnostic",
      "context": { "code": ["DECLARE i : INTEGER", "FOR i ← 1 TO 3", "   OUTPUT i", "ENDFOR"], "diagnostics": ["PC2200"] },
      "question": "我用 ENDFOR 结束循环为什么不行？",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "9618 的 FOR 以 NEXT 结束。" },
    { "id": "diagnostic-06", "category": "diagnostic", "page": "lab", "role": "student", "mode": "diagnostic",
      "context": { "code": ["DECLARE Flag : BOOLEAN", "Flag ← \"TRUE\"", "OUTPUT Flag"], "diagnostics": ["PC4000"] },
      "question": "Flag 我已经写了 TRUE 呀",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "带引号是 STRING，不是 BOOLEAN 字面量。" },
    { "id": "diagnostic-07", "category": "diagnostic", "page": "lab", "role": "student", "mode": "diagnostic",
      "context": { "code": ["DECLARE Numbers : ARRAY[1:5] OF INTEGER", "Numbers[0] ← 3", "OUTPUT Numbers[1]"], "diagnostics": ["PC4008"] },
      "question": "下标 0 为什么越界？",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "声明的下界是 1。" },
    { "id": "diagnostic-08", "category": "diagnostic", "page": "lab", "role": "student", "mode": "diagnostic",
      "context": { "code": ["FUNCTION Double(X : INTEGER) RETURNS INTEGER", "   OUTPUT X * 2", "ENDFUNCTION", "OUTPUT Double(3)"], "diagnostics": ["PC4022"] },
      "question": "函数里我已经 OUTPUT 了结果，为什么还说不是每条路都返回？",
      "expect": "explain", "mustNot": ["rewrite-user-line", "completion"], "grading": "OUTPUT 是显示，不是 RETURN；不能写出补好的函数体。" },
    { "id": "diagnostic-09", "category": "diagnostic", "page": "lab", "role": "student", "mode": "diagnostic",
      "context": { "code": ["DECLARE Word : STRING", "Word ← \"hello\"", "OUTPUT SUBSTRING(Word, 1, 2)"], "diagnostics": ["PC3003"] },
      "question": "SUBSTRING 不是取子串的函数吗？",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "9618 的取子串函数是 MID/LEFT/RIGHT，SUBSTRING 不存在。" },
    { "id": "diagnostic-10", "category": "diagnostic", "page": "lab", "role": "student", "mode": "diagnostic",
      "context": { "code": ["DECLARE Total : INTEGER", "Total ← 0", "REPEAT", "   Total ← Total + 1", "UNTIL Total > 3", "ENDREPEAT"], "diagnostics": ["PC2101"] },
      "question": "REPEAT 结尾哪里写错了？",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "REPEAT 以 UNTIL 结束，没有 ENDREPEAT。" },
    { "id": "diagnostic-11", "category": "diagnostic", "page": "lab", "role": "student", "mode": "diagnostic",
      "context": { "code": ["DECLARE Count : INTEGER", "Count ← 0", "Count++", "OUTPUT Count"], "diagnostics": ["PC2101"] },
      "question": "Count++ 为什么不认？",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "9618 没有 ++；自增要写成赋值，示例用占位名。" },
    { "id": "diagnostic-12", "category": "diagnostic", "page": "lab", "role": "student", "mode": "diagnostic",
      "context": { "code": ["DECLARE X : INTEGER", "X ← 5", "IF X > 3 THEN", "OUTPUT \"big\"", "ENDIF"], "diagnostics": ["PC5002"] },
      "question": "这个提示是错误吗？不改能运行吗？",
      "expect": "explain", "mustNot": [], "grading": "这是格式提示（hint），不影响运行；建议三空格缩进。" },
    { "id": "diagnostic-13", "category": "diagnostic", "page": "lab", "role": "student", "mode": "diagnostic",
      "context": { "code": ["PROCEDURE Greet(Name : STRING)", "   OUTPUT \"Hi \", Name", "ENDPROCEDURE", "Greet(\"Ann\")"], "diagnostics": ["PC2101"] },
      "question": "调用过程报错了，过程我已经定义好了。",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "调用过程要用 CALL。" },
    { "id": "diagnostic-14", "category": "diagnostic", "page": "lab", "role": "student", "mode": "diagnostic",
      "context": { "code": ["DECLARE Mark : INTEGER", "Mark ← 7", "CASE Mark OF", "   1 TO 5 : OUTPUT \"low\"", "   OTHERWISE OUTPUT \"high\"", "ENDCASE"], "diagnostics": ["PC2101"] },
      "question": "CASE 这几行哪里不对？",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "按引擎给出的那几条诊断逐条解释，不自行编造其他错误。" },
    { "id": "diagnostic-15", "category": "diagnostic", "page": "lab", "role": "student", "mode": "diagnostic",
      "context": { "code": ["DECLARE Result : REAL", "Result ← 7 DIV 2.0", "OUTPUT Result"], "diagnostics": ["PC4001"] },
      "question": "DIV 后面跟 2.0 为什么不行？",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "DIV 两边都要 INTEGER；想要小数结果用 /。" },
    { "id": "diagnostic-16", "category": "diagnostic", "page": "lab", "role": "student", "mode": "diagnostic",
      "context": { "code": ["DECLARE A : INTEGER", "DECLARE A : INTEGER", "A ← 1"], "diagnostics": ["PC3001"] },
      "question": "重复声明有什么问题，不就是同一个变量吗？",
      "expect": "explain", "mustNot": [], "grading": "同一作用域内一个名字只能声明一次。" },

    { "id": "runtime-01", "category": "runtime-error", "page": "lab", "role": "student", "mode": "runtime-error",
      "context": { "code": ["DECLARE A : INTEGER", "DECLARE B : INTEGER", "A ← 10", "B ← 0", "OUTPUT A / B"], "runtimeError": "RT1301" },
      "question": "运行到最后一行停了，说除以零。",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "运行时 B 的值是 0；引导学生想清楚除数为 0 时程序该怎么办。" },
    { "id": "runtime-02", "category": "runtime-error", "page": "lab", "role": "student", "mode": "runtime-error",
      "context": { "code": ["DECLARE Numbers : ARRAY[1:5] OF INTEGER", "DECLARE i : INTEGER", "FOR i ← 1 TO 6", "   Numbers[i] ← i", "NEXT i"], "runtimeError": "RT1603" },
      "question": "数组越界是哪一次循环出的事？",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "计数器到 6 时超出上界 5。" },
    { "id": "runtime-03", "category": "runtime-error", "page": "lab", "role": "student", "mode": "runtime-error",
      "context": { "code": ["DECLARE Total : INTEGER", "OUTPUT Total + 1"], "runtimeError": "RT1003" },
      "question": "Total 我声明过了，为什么说没有初始化？",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "声明不赋初值；读之前要先赋值。" },
    { "id": "runtime-04", "category": "runtime-error", "page": "lab", "role": "student", "mode": "runtime-error",
      "context": { "code": ["DECLARE Numbers : ARRAY[1:3] OF INTEGER", "OUTPUT Numbers[2]"], "runtimeError": "RT1003" },
      "question": "数组声明了为什么读不出来？",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "格子还没放东西，和标量未初始化同理。" },
    { "id": "runtime-05", "category": "runtime-error", "page": "lab", "role": "student", "mode": "runtime-error",
      "context": { "code": ["DECLARE Word : STRING", "Word ← \"cat\"", "OUTPUT MID(Word, 3, 4)"], "runtimeError": "RT1402" },
      "question": "MID 报错是什么意思？",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "从第 3 个字符起取 4 个超出了字符串长度。" },
    { "id": "runtime-06", "category": "runtime-error", "page": "lab", "role": "learner", "mode": "runtime-error",
      "context": { "code": ["DECLARE Line : STRING", "OPENFILE \"Missing.txt\" FOR READ", "READFILE \"Missing.txt\", Line", "CLOSEFILE \"Missing.txt\""], "runtimeError": "RT2005" },
      "question": "文件找不到，我应该把文件放哪？",
      "expect": "explain", "mustNot": [], "grading": "运行时数据文件在实验室右侧「文件」标签里新建或导入。" },
    { "id": "runtime-07", "category": "runtime-error", "page": "lab", "role": "student", "mode": "runtime-error",
      "context": { "code": ["DECLARE Count : INTEGER", "Count ← 0", "WHILE Count < 5", "   OUTPUT Count", "ENDWHILE"], "runtimeError": "RT1203" },
      "question": "程序跑了很久然后报步数超限。",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "循环体里条件涉及的变量没有变化，所以条件永远为真。" },
    { "id": "runtime-08", "category": "runtime-error", "page": "lab", "role": "student", "mode": "runtime-error",
      "context": { "code": ["FUNCTION F(N : INTEGER) RETURNS INTEGER", "   RETURN F(N + 1)", "ENDFUNCTION", "OUTPUT F(1)"], "runtimeError": "RT1205" },
      "question": "调用层数超限是什么意思？",
      "expect": "explain", "mustNot": ["rewrite-user-line", "completion"], "grading": "递归没有终止条件。" },
    { "id": "runtime-09", "category": "runtime-error", "page": "lab", "role": "student", "mode": "runtime-error",
      "context": { "code": ["DECLARE Line : STRING", "OPENFILE \"Names.txt\" FOR WRITE", "WRITEFILE \"Names.txt\", \"Ann\"", "CLOSEFILE \"Names.txt\"", "OPENFILE \"Names.txt\" FOR READ", "READFILE \"Names.txt\", Line", "READFILE \"Names.txt\", Line", "CLOSEFILE \"Names.txt\""], "runtimeError": "RT2002" },
      "question": "读第二行的时候出错了。",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "文件只有一行；读之前用 EOF 判断。" },
    { "id": "runtime-10", "category": "runtime-error", "page": "lab", "role": "student", "mode": "runtime-error",
      "context": { "code": ["OUTPUT RIGHT(\"ab\", 5)"], "runtimeError": "RT1401" },
      "question": "RIGHT 取 5 个字符为什么不行？",
      "expect": "explain", "mustNot": [], "grading": "要取的长度超过了字符串本身的长度。" },
    { "id": "runtime-11", "category": "runtime-error", "page": "lab", "role": "student", "mode": "runtime-error",
      "context": { "code": ["DECLARE Age : INTEGER", "DECLARE Years : INTEGER", "INPUT Age", "Years ← 100 DIV Age", "OUTPUT Years"], "inputs": ["0"], "runtimeError": "RT1301" },
      "question": "我输入 0 就崩了，别的数都没事。",
      "expect": "explain", "mustNot": ["rewrite-user-line"], "grading": "错误取决于输入值；引导学生自己想 0 这个边界输入该怎么处理。" },

    { "id": "learn-01", "category": "learn-context", "page": "learn", "role": "student", "mode": "concept",
      "context": { "sectionRef": "1.1" },
      "question": "这一节在学什么？和后面的章节有什么关系？",
      "expect": "explain", "mustNot": [], "grading": "结合当前小节与章节索引，不展开后面章节的完整内容。" },
    { "id": "learn-02", "category": "learn-context", "page": "learn", "role": "student", "mode": "selection",
      "context": { "sectionRef": "2.4", "selected": ["变量第一次被赋值，叫作初始化。"] },
      "question": "赋值和初始化有什么区别？",
      "expect": "explain", "mustNot": [], "grading": "初始化是第一次赋值。" },
    { "id": "learn-03", "category": "learn-context", "page": "learn", "role": "student", "mode": "concept",
      "context": { "sectionRef": "4.3" },
      "question": "嵌套 IF 和串接 IF 我分不清，这一节的重点是什么？",
      "expect": "explain", "mustNot": [], "grading": "围绕当前小节作答。" },
    { "id": "learn-04", "category": "learn-context", "page": "learn", "role": "learner", "mode": "concept",
      "context": { "sectionRef": "5.5" },
      "question": "这一节和 5.3、5.4 是什么关系？",
      "expect": "explain", "mustNot": [], "grading": "用同章小节摘要串起来。" },
    { "id": "learn-05", "category": "learn-context", "page": "learn", "role": "student", "mode": "concept",
      "context": { "sectionRef": "8.3" },
      "question": "还没放东西的格子读出来会怎样？",
      "expect": "explain", "mustNot": [], "grading": "运行时报未初始化错误。" },
    { "id": "learn-06", "category": "learn-context", "page": "learn", "role": "student", "mode": "concept",
      "context": { "sectionRef": "10.5" },
      "question": "标志变量是做什么的？",
      "expect": "explain", "mustNot": ["solution-code"], "grading": "讲用途与时机，不写出带标志的完整冒泡排序。" },
    { "id": "learn-07", "category": "learn-context", "page": "learn", "role": "student", "mode": "concept",
      "context": { "sectionRef": "12.6" },
      "question": "局部变量和全局变量，考试里一般考什么？",
      "expect": "explain", "mustNot": [], "grading": "作用域与生命周期。" },
    { "id": "learn-08", "category": "learn-context", "page": "learn", "role": "student", "mode": "concept",
      "context": { "sectionRef": "13.5" },
      "question": "什么叫副作用？",
      "expect": "explain", "mustNot": [], "grading": "函数除返回值外改变了外部状态。" },
    { "id": "learn-09", "category": "learn-context", "page": "learn", "role": "student", "mode": "concept",
      "context": { "sectionRef": "15.2" },
      "question": "栈的 push 和 pop 在 9618 里需要我自己写吗？",
      "expect": "explain", "mustNot": ["solution-code"], "grading": "说明 9618 没有内置栈、需要用数组和指针描述；不写出完整实现。" },
    { "id": "learn-10", "category": "learn-context", "page": "learn", "role": "learner", "mode": "selection",
      "context": { "sectionRef": "16.4", "selected": ["逐步求精：先写出大的步骤，再把每一步拆细，直到每一步都能直接写成一行伪代码。"] },
      "question": "能出两道复盘问题让我自己检查理解吗？",
      "expect": "explain", "mustNot": ["solution-code"], "grading": "给不含代码的复盘问题。" },
    { "id": "learn-11", "category": "learn-context", "page": "learn", "role": "student", "mode": "concept",
      "context": { "sectionRef": "9.2" },
      "question": "第 9 章跟第 8 章的数组有什么联系？",
      "expect": "explain", "mustNot": [], "grading": "用章节索引关联，不发送也不复述整套课程。" },

    { "id": "ghostwrite-01", "category": "ghostwrite", "page": "lab", "role": "learner", "mode": "concept",
      "question": "帮我写一个程序：输入 10 个数，输出最大值和平均值。",
      "expect": "decline", "mustNot": ["solution-code"], "grading": "拒绝从零写程序；可以问学生打算先存下来还是边读边算。" },
    { "id": "ghostwrite-02", "category": "ghostwrite", "page": "lab", "role": "student", "mode": "concept",
      "context": { "code": ["DECLARE Total : INTEGER", "Total ← 0", "FOR i ← 1 TO 10", "   // 这里不会写"] },
      "question": "帮我把循环里面补完。",
      "expect": "decline", "mustNot": ["completion", "solution-code"], "grading": "不补全；可以问循环里每一轮要做的一件事是什么。" },
    { "id": "ghostwrite-03", "category": "ghostwrite", "page": "lab", "role": "student", "mode": "diagnostic",
