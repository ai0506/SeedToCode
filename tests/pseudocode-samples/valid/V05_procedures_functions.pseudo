// V05 - PROCEDURE / FUNCTION，BYREF 与 BYVAL 参数
PROCEDURE DrawLine()
    OUTPUT "--------------------"
ENDPROCEDURE

PROCEDURE Greet(Name : STRING, Times : INTEGER)
    DECLARE k : INTEGER
    FOR k ← 1 TO Times
        OUTPUT "Hello, ", Name
    NEXT k
ENDPROCEDURE

PROCEDURE Swap(BYREF X : INTEGER, BYREF Y : INTEGER)
    DECLARE Temp : INTEGER
    Temp ← X
    X ← Y
    Y ← Temp
ENDPROCEDURE

PROCEDURE ShowValue(BYVAL N : INTEGER)
    N ← N + 1
    OUTPUT "Local copy: ", N
ENDPROCEDURE

FUNCTION Max(A : INTEGER, B : INTEGER) RETURNS INTEGER
    IF A > B THEN
        RETURN A
    ELSE
        RETURN B
    ENDIF
ENDFUNCTION

FUNCTION SumTo(N : INTEGER) RETURNS INTEGER
    DECLARE Total : INTEGER
    DECLARE i : INTEGER
    Total ← 0
    FOR i ← 1 TO N
        Total ← Total + i
    NEXT i
    RETURN Total
ENDFUNCTION

DECLARE P : INTEGER
DECLARE Q : INTEGER
DECLARE Result : INTEGER

P ← 3
Q ← 8

CALL DrawLine()
CALL Greet("World", 2)
CALL Swap(P, Q)
CALL ShowValue(P)

Result ← Max(P, Q) + SumTo(5)
OUTPUT "Result = ", Result
