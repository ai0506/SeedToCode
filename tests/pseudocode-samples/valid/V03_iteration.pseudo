// V03 - FOR / WHILE / REPEAT 三种循环，含 STEP 与嵌套
DECLARE i : INTEGER
DECLARE j : INTEGER
DECLARE Total : INTEGER
DECLARE Answer : CHAR

Total ← 0

FOR i ← 1 TO 10
    Total ← Total + i
NEXT i

FOR i ← 10 TO 1 STEP -2
    OUTPUT "Countdown: ", i
NEXT i

FOR i ← 1 TO 3
    FOR j ← 1 TO 3
        OUTPUT i * j
    NEXT j
NEXT i

i ← 0
WHILE i < 5
    OUTPUT "While loop pass ", i
    i ← i + 1
ENDWHILE

REPEAT
    OUTPUT "Continue? (Y/N)"
    INPUT Answer
UNTIL Answer = 'N' OR Answer = 'n'

OUTPUT "Total = ", Total
