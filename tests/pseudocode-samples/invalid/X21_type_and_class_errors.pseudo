    DECLARE Surname : STRING
    DECLARE Year : INTEGER
// 缺少 ENDTYPE

CLASS Pet
    PRIVATE Name : STRING

    PUBLIC FUNCTION GetName() RETURNS STRING
        RETURN Name
    ENDPROCEDURE          // 与 FUNCTION 不配对
ENDCLASS

DECLARE P : Pet
P ← NEW Pet()
OUTPUT P.Name             // 访问 PRIVATE 属性
